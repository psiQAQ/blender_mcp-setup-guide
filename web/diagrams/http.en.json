  "cards": [
    {
      "dot": "cyan",
      "title": "Interfaces and requests",
      "items": [
        "The agent uses Streamable HTTP at http://127.0.0.1:8000/ with a Bearer token.",
        "The TCP bridge defaults to localhost:9876; arrows distinguish requests and returned results."
      ]
    },
    {
      "dot": "amber",
      "title": "Who controls the service?",
      "items": [
        "The integrated Extension starts and stops the independent MCP service; the agent connects to its URL.",
        "Disabling the Extension or exiting Blender ends its service; enabling it can auto-start it."
      ]
    },
    {
      "dot": "emerald",
      "title": "Installation locations and processes",
      "items": [
        "Background frames mark installation areas; node subtitles identify processes. One package may supply code for separate processes.",
        "The ZIP contains the bridge, MCP tools, API / manual data and private dependencies; its interpreter comes from the Blender installation."
      ]
    },
    {
      "dot": "slate",
      "title": "Local configuration",
      "items": [
        "The client and Blender run in the same native OS on one computer; use the actual configured ports and paths.",
        "Logs, the HTTP token and session files live in the Extension user data directory."
      ]
    }
  ]
